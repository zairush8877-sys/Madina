---
import { site } from '../content/site';
---

<section class="section contacts" id="contacts">
  <div class="contacts__glow" aria-hidden="true"></div>
  <div class="wrap contacts__inner">
    <div class="contacts__text">
      <p class="eyebrow reveal">{site.contacts.eyebrow}</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">{site.contacts.title}</h2>
      <p class="contacts__lede reveal" style="--reveal-delay: 0.12s">
        {site.contacts.lede}
      </p>
    </div>

    <div class="contacts__actions glass reveal" style="--reveal-delay: 0.15s">
      <a
        class="btn"
        href={site.contacts.whatsappHref}
        target="_blank"
        rel="noopener"
      >
        {site.contacts.whatsappLabel}
      </a>
      <a class="btn btn--ghost" href={`tel:${site.contacts.phoneHref}`}>
        {site.contacts.phoneLabel}
      </a>
      <p class="contacts__meta">
        {site.contacts.preferred}<br />
        {site.contacts.areaServed}
      </p>
    </div>
  </div>
</section>

<style>
  .contacts {
    position: relative;
    overflow: hidden;
  }

  .contacts__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 70% at 50% 110%, rgba(226, 96, 123, 0.16), transparent 70%),
      radial-gradient(35% 50% at 15% 0%, rgba(127, 90, 240, 0.1), transparent 70%);
    pointer-events: none;
  }

  .contacts__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }

  .contacts__lede {
    margin-top: 1.5rem;
    color: var(--ink-2);
    max-width: 46ch;
    font-size: clamp(1.02rem, 1rem + 0.3vw, 1.15rem);
  }

  .contacts__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(1.75rem, 3vw, 2.5rem);
  }

  .contacts__meta {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    color: var(--ink-3);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .contacts__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
