---
import { site } from '../content/site';
---

<section class="section contacts" id="contacts">
  <div class="wrap contacts__inner">
    <p class="eyebrow reveal">{site.contacts.eyebrow}</p>
    <h2 class="reveal" style="--reveal-delay: 0.06s">{site.contacts.title}</h2>
    <p class="contacts__lede reveal" style="--reveal-delay: 0.12s">
      {site.contacts.lede}
    </p>

    <div class="contacts__actions reveal" style="--reveal-delay: 0.18s">
      <a
        class="btn contacts__btn-brass"
        href={site.contacts.whatsappHref}
        target="_blank"
        rel="noopener"
      >
        {site.contacts.whatsappLabel}
      </a>
      <a class="btn contacts__btn-outline" href={`tel:${site.contacts.phoneHref}`}>
        {site.contacts.phoneLabel}
      </a>
    </div>

    <p class="contacts__meta reveal" style="--reveal-delay: 0.24s">
      {site.contacts.preferred} · {site.contacts.areaServed}
    </p>
  </div>
</section>

<style>
  .contacts {
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    text-align: center;
  }

  .contacts__inner {
    position: relative;
  }

  .contacts .eyebrow {
    color: var(--brass-2);
  }

  .contacts .eyebrow::before {
    background: var(--brass-2);
  }

  .contacts__lede {
    margin: 1.5rem auto 0;
    color: #c8c0b2;
    max-width: 52ch;
    font-size: clamp(1rem, 0.97rem + 0.3vw, 1.12rem);
  }

  .contacts__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
    margin-top: 2.6rem;
  }

  /* Латунная кнопка — главный акцент тёмной секции. */
  .contacts__btn-brass {
    background: linear-gradient(135deg, var(--brass-2), var(--brass));
    border-color: transparent;
    color: var(--ink);
  }

  .contacts__btn-brass:hover,
  .contacts__btn-brass:focus-visible {
    background: linear-gradient(135deg, var(--brass-2), var(--brass));
    filter: brightness(1.12);
    border-color: transparent;
    color: var(--ink);
  }

  .contacts__btn-outline {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.4);
    color: var(--paper);
  }

  .contacts__btn-outline:hover,
  .contacts__btn-outline:focus-visible {
    background: transparent;
    border-color: var(--brass-2);
    color: var(--brass-2);
    box-shadow: none;
  }

  .contacts__meta {
    margin-top: 2.25rem;
    font-size: 0.85rem;
    color: #8f8778;
  }
</style>
