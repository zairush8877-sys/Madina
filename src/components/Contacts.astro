---
import { site } from '../content/site';
---

<section class="section contacts" id="contacts">
  <div class="shapes" aria-hidden="true">
    <span class="shape shape--ring c-sh1" data-depth="0.22"></span>
    <span
      class="shape shape--circle c-sh2"
      data-depth="0.45"
      style="background: var(--yellow)"></span>
    <span class="shape c-sh3" data-depth="0.3"></span>
  </div>

  <div class="wrap contacts__inner">
    <p class="eyebrow reveal">{site.contacts.eyebrow}</p>
    <h2 class="reveal" style="--reveal-delay: 0.06s">{site.contacts.title}</h2>
    <p class="contacts__lede reveal" style="--reveal-delay: 0.12s">
      {site.contacts.lede}
    </p>

    <div class="contacts__actions reveal" style="--reveal-delay: 0.18s">
      <a
        class="btn contacts__btn-light"
        href={site.contacts.whatsappHref}
        target="_blank"
        rel="noopener"
      >
        {site.contacts.whatsappLabel}
      </a>
      <a class="btn contacts__btn-outline" href={`tel:${site.contacts.phoneHref}`}>
        {site.contacts.phoneLabel}
      </a>
    </div>

    <p class="contacts__meta reveal" style="--reveal-delay: 0.24s">
      {site.contacts.preferred} · {site.contacts.areaServed}
    </p>
  </div>
</section>

<style>
  .contacts {
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    text-align: center;
  }

  .c-sh1 {
    width: 420px;
    height: 420px;
    border: 2px dashed rgba(244, 239, 230, 0.35);
    top: -160px;
    left: -130px;
    animation: spin 52s linear infinite;
  }

  .c-sh2 {
    width: 50px;
    height: 50px;
    bottom: 18%;
    right: 10%;
    animation: bob 6s ease-in-out infinite;
  }

  .c-sh3 {
    width: 0;
    height: 0;
    border-left: 60px solid transparent;
    border-right: 60px solid transparent;
    border-bottom: 100px solid var(--red);
    top: 12%;
    right: -26px;
    animation: drift 17s ease-in-out infinite;
  }

  .contacts__inner {
    position: relative;
  }

  .contacts .eyebrow {
    background: transparent;
    color: var(--paper);
    border-color: var(--paper);
  }

  .contacts__lede {
    margin: 1.5rem auto 0;
    color: #c9c3b7;
    max-width: 52ch;
    font-size: clamp(1rem, 0.97rem + 0.3vw, 1.12rem);
  }

  .contacts__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
    margin-top: 2.5rem;
  }

  .contacts__btn-light {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--ink);
    box-shadow: 4px 4px 0 0 var(--red);
  }

  .contacts__btn-light:hover,
  .contacts__btn-light:focus-visible {
    box-shadow: 7px 7px 0 0 var(--red);
  }

  .contacts__btn-outline {
    background: transparent;
    border-color: var(--paper);
    color: var(--paper);
    box-shadow: 4px 4px 0 0 var(--blue);
  }

  .contacts__btn-outline:hover,
  .contacts__btn-outline:focus-visible {
    box-shadow: 7px 7px 0 0 var(--blue);
  }

  .contacts__meta {
    margin-top: 2.25rem;
    font-size: 0.85rem;
    color: #8f887b;
  }
</style>
