---
import { site } from '../content/site';

// Каждой карточке — своя фигура-маркер одного из трёх основных цветов.
const shapeKinds = ['circle', 'square', 'triangle'] as const;
---

<section class="section services-section" id="services">
  <div class="shapes" aria-hidden="true">
    <span class="shape shape--ring svc-sh1" data-depth="0.22"></span>
    <span class="shape svc-sh2" data-depth="0.45"></span>
  </div>

  <div class="wrap">
    <header class="services__head">
      <p class="eyebrow reveal">Услуги</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">
        От первого чертежа<br />до <span class="accent-red">последней ручки</span>
      </h2>
      <p class="lede reveal" style="--reveal-delay: 0.12s">
        Можно взять только проект, а можно передать мне весь объект — вместе
        с бригадами, закупками и приёмкой. Как удобнее вам.
      </p>
    </header>

    <ul class="services__grid" role="list">
      {
        site.services.map((service, i) => (
          <li
            class="service reveal"
            data-tilt
            style={`--reveal-delay: ${(i % 4) * 0.07}s`}
          >
            <span
              class={`service__shape service__shape--${shapeKinds[i % 3]}`}
              aria-hidden="true"
            />
            <span class="service__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="service__title">{service.title}</h3>
            <p class="service__summary">{service.summary}</p>
            <ul class="service__points" role="list">
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services-section {
    overflow: hidden;
  }

  .svc-sh1 {
    width: 380px;
    height: 380px;
    border: 2px dashed var(--blue);
    bottom: -140px;
    right: -120px;
    animation: spin 56s linear infinite;
  }

  .svc-sh2 {
    width: 90px;
    height: 20px;
    background: var(--yellow);
    top: 12%;
    right: 4%;
    animation: drift 16s ease-in-out infinite;
  }

  .services__head {
    max-width: 54rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .services__head h2 {
    margin-bottom: 1.25rem;
  }

  .services__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.4rem;
    position: relative;
  }

  .service {
    position: relative;
    padding: 1.9rem 1.7rem;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 3px solid var(--ink);
    transition: transform 0.2s ease, box-shadow 0.25s var(--ease-out);
    will-change: transform;
  }

  .service:hover {
    box-shadow: 8px 8px 0 0 var(--ink);
  }

  /* Фигура-маркер вращается/крутится при наведении на карточку. */
  .service__shape {
    display: block;
    margin-bottom: 1.2rem;
    transition: rotate 0.6s var(--ease-out), scale 0.3s ease;
  }

  .service__shape--circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--red);
  }

  .service__shape--square {
    width: 38px;
    height: 38px;
    background: var(--yellow);
  }

  .service__shape--triangle {
    width: 0;
    height: 0;
    border-left: 22px solid transparent;
    border-right: 22px solid transparent;
    border-bottom: 38px solid var(--blue);
    background: none;
  }

  .service:hover .service__shape {
    rotate: 180deg;
    scale: 1.12;
  }

  .service__num {
    position: absolute;
    top: 1.2rem;
    right: 1.4rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    color: var(--ink-3);
  }

  .service__title {
    margin-bottom: 0.8rem;
  }

  .service__summary {
    color: var(--ink-2);
    font-size: 0.93rem;
    margin-bottom: 1.3rem;
  }

  .service__points {
    list-style: none;
    margin: auto 0 0;
    padding: 1.1rem 0 0;
    border-top: 2px solid var(--ink);
    display: grid;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-2);
  }

  .service__points li {
    position: relative;
    padding-left: 1.15rem;
  }

  .service__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 8px;
    height: 8px;
    background: var(--red);
    rotate: 45deg;
  }
</style>
