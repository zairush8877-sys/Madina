---
import { site } from '../content/site';
---

<section class="section" id="services">
  <div class="wrap">
    <header class="services__head">
      <p class="eyebrow reveal">Услуги</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">
        От первого чертежа<br />до <span class="accent">последней ручки</span>
      </h2>
      <p class="lede reveal" style="--reveal-delay: 0.12s">
        Можно взять только проект, а можно передать мне весь объект — вместе
        с бригадами, закупками и приёмкой. Как удобнее вам.
      </p>
    </header>

    <ul class="services__grid" role="list">
      {
        site.services.map((service, i) => (
          <li
            class="service glass reveal"
            data-tilt
            style={`--reveal-delay: ${(i % 4) * 0.07}s`}
          >
            <span class="service__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="service__title">{service.title}</h3>
            <p class="service__summary">{service.summary}</p>
            <ul class="service__points" role="list">
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__head {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .services__head h2 {
    margin-bottom: 1.25rem;
  }

  .services__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.1rem;
  }

  .service {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.3s ease;
    will-change: transform;
  }

  /* Блик, следующий за курсором (координаты задаёт motion.ts). */
  .service::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      220px circle at var(--px, 50%) var(--py, 50%),
      rgba(245, 178, 99, 0.14),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .service:hover {
    border-color: rgba(245, 178, 99, 0.35);
  }

  .service:hover::before {
    opacity: 1;
  }

  .service__num {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    background: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .service__title {
    margin: 0.8rem 0 0.85rem;
  }

  .service__summary {
    color: var(--ink-2);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  .service__points {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--ink-2);
  }

  .service__points li {
    position: relative;
    padding-left: 1.1rem;
  }

  .service__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 1px;
    background: var(--glow-a);
    box-shadow: 0 0 6px rgba(245, 178, 99, 0.9);
  }
</style>
