---
import LuxObject from './LuxObject.astro';
import { site } from '../content/site';
---

<section class="section services-section" id="services">
  <div class="decor" aria-hidden="true">
    <LuxObject name="key" class="svc-obj svc-obj--key sway" depth={0.3} />
    <LuxObject name="lever" class="svc-obj svc-obj--lever floaty" depth={0.45} />
  </div>

  <div class="wrap">
    <header class="services__head">
      <p class="eyebrow reveal">Услуги</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">
        От первого чертежа<br />до <em class="accent">последней ручки</em>
      </h2>
      <p class="lede reveal" style="--reveal-delay: 0.12s">
        Можно взять только проект, а можно передать мне весь объект — вместе
        с бригадами, закупками и приёмкой. Как удобнее вам.
      </p>
    </header>

    <ul class="services__grid" role="list">
      {
        site.services.map((service, i) => (
          <li
            class="service reveal"
            data-tilt
            style={`--reveal-delay: ${((i % 4) * 0.07).toFixed(2)}s`}
          >
            <span class="service__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="service__gem" aria-hidden="true" />
            <h3 class="service__title">{service.title}</h3>
            <p class="service__summary">{service.summary}</p>
            <ul class="service__points" role="list">
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services-section {
    overflow: hidden;
  }

  :global(.svc-obj--key) {
    width: 34px;
    top: 9%;
    right: 5%;
  }

  :global(.svc-obj--lever) {
    width: 88px;
    bottom: 6%;
    left: -12px;
    color: var(--ink-3);
  }

  .services__head {
    max-width: 54rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .services__head h2 {
    margin-bottom: 1.25rem;
  }

  .services__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.4rem;
    position: relative;
  }

  .service {
    position: relative;
    padding: 2rem 1.8rem;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--hairline);
    /* Shorthand перекрывает transition из .js .reveal (идёт позже
       в собранном CSS), поэтому переходы появления — opacity и translate
       с задержкой каскада — обязаны повторяться здесь. transform остаётся
       быстрым: его пишет tilt-эффект из motion.ts. */
    transition: transform 0.2s ease, box-shadow 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out),
      opacity 0.85s var(--ease-out) var(--reveal-delay, 0s),
      translate 0.85s var(--ease-out) var(--reveal-delay, 0s);
    will-change: transform;
  }

  .service:hover {
    border-color: var(--brass);
    box-shadow: var(--shadow-soft);
  }

  .service__num {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 2.3rem;
    line-height: 1;
    color: var(--blush);
    margin-bottom: 1.1rem;
    transition: color 0.4s var(--ease-out);
  }

  .service:hover .service__num {
    color: var(--brass-2);
  }

  /* Латунный ромб проворачивается при наведении. */
  .service__gem {
    position: absolute;
    top: 2.2rem;
    right: 1.7rem;
    width: 8px;
    height: 8px;
    background: var(--brass);
    rotate: 45deg;
    transition: rotate 0.6s var(--ease-out), scale 0.4s ease;
  }

  .service:hover .service__gem {
    rotate: 225deg;
    scale: 1.25;
  }

  .service__title {
    margin-bottom: 0.8rem;
  }

  .service__summary {
    color: var(--ink-2);
    font-size: 0.93rem;
    margin-bottom: 1.3rem;
  }

  .service__points {
    list-style: none;
    margin: auto 0 0;
    padding: 1.1rem 0 0;
    border-top: 1px solid var(--hairline);
    display: grid;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-2);
  }

  .service__points li {
    position: relative;
    padding-left: 1.15rem;
  }

  .service__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    background: var(--brass);
    rotate: 45deg;
  }
</style>
