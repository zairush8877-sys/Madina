---
/**
 * Живые предметы интерьера — тонкая линейная графика (stroke),
 * каждая со своим характером движения (класс движения задаётся
 * в месте использования: sway / rock / press / floaty / bob).
 *
 * Обёртка получает [data-depth] — параллакс из motion.ts пишет
 * в style.transform, а keyframes двигают svg через rotate/translate,
 * поэтому движения складываются, не мешая друг другу.
 */
interface Props {
  /** Какой предмет нарисовать. */
  name: 'pendant' | 'chair' | 'lever' | 'key' | 'vase' | 'mirror' | 'floorlamp';
  /** Классы позиционирования/движения для обёртки. */
  class?: string;
  /** Глубина параллакса за курсором (0 — не плывёт). */
  depth?: number;
}

const { name, class: className = '', depth } = Astro.props;
---

<span
  class:list={['lux-obj', `lux-obj--${name}`, className]}
  data-depth={depth}
  aria-hidden="true"
>
  {
    name === 'pendant' && (
      <svg viewBox="0 0 60 92" class="obj-svg obj-svg--pendant">
        <path d="M30 0 V36" />
        <path d="M12 62 A18 18 0 0 1 48 62 Z" />
        <circle cx="30" cy="70" r="4" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  {
    name === 'chair' && (
      <svg viewBox="0 0 64 96" class="obj-svg obj-svg--chair">
        <ellipse cx="32" cy="20" rx="13" ry="16" />
        <path d="M24 33 L21 55" />
        <path d="M40 33 L43 55" />
        <path d="M14 56 Q32 48 50 56" />
        <path d="M18 57 L13 92" />
        <path d="M46 57 L51 92" />
        <path d="M30 57 L28 92" />
      </svg>
    )
  }
  {
    name === 'lever' && (
      <svg viewBox="0 0 92 40" class="obj-svg obj-svg--lever">
        <circle cx="18" cy="20" r="7" />
        <g class="lever-arm">
          <path d="M25 20 C46 11 66 13 84 18" />
          <circle cx="84" cy="18" r="3.5" fill="currentColor" stroke="none" />
        </g>
      </svg>
    )
  }
  {
    name === 'key' && (
      <svg viewBox="0 0 40 96" class="obj-svg obj-svg--key">
        <circle cx="20" cy="14" r="10" />
        <circle cx="20" cy="14" r="3.5" />
        <path d="M20 24 V80" />
        <path d="M20 80 H32" />
        <path d="M20 68 H28" />
      </svg>
    )
  }
  {
    name === 'vase' && (
      <svg viewBox="0 0 60 92" class="obj-svg obj-svg--vase">
        <path d="M30 44 C28 30 38 22 46 10" />
        <path d="M40 22 C44 20 48 20 52 22" />
        <path d="M33 32 C36 28 40 27 44 28" />
        <path d="M24 52 V45 H36 V52" />
        <path d="M24 52 C12 60 14 78 24 88 H36 C46 78 48 60 36 52 Z" />
      </svg>
    )
  }
  {
    name === 'mirror' && (
      <svg viewBox="0 0 60 96" class="obj-svg obj-svg--mirror">
        <path d="M8 92 V36 A22 22 0 0 1 52 36 V92 Z" />
        <path d="M15 92 V38 A15 15 0 0 1 45 38 V92" />
      </svg>
    )
  }
  {
    name === 'floorlamp' && (
      <svg viewBox="0 0 70 112" class="obj-svg obj-svg--floorlamp">
        <path d="M22 8 H48 L55 36 H15 Z" />
        <path d="M35 36 V88" />
        <path d="M35 88 L21 106" />
        <path d="M35 88 L49 106" />
        <path d="M35 88 V106" />
      </svg>
    )
  }
</span>

<style>
  .lux-obj {
    position: absolute;
    display: block;
    color: var(--brass);
    will-change: transform;
  }

  .obj-svg {
    width: 100%;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Точки вращения для «характерных» движений. */
  .obj-svg--pendant {
    transform-origin: 50% 0;
  }

  .obj-svg--key {
    transform-origin: 50% 8%;
  }

  .obj-svg--chair {
    transform-origin: 50% 96%;
  }

  /* Рычаг ручки нажимается вокруг розетки. */
  .lever-arm {
    transform-origin: 18px 20px;
    animation: press 7s var(--ease-out) infinite;
  }

  /* Движение назначается снаружи классами: например,
     class="sway" на обёртке анимирует сам svg. */
  :global(.sway) .obj-svg {
    animation: sway 6.5s ease-in-out infinite;
  }

  :global(.sway-slow) .obj-svg {
    animation: sway 9s ease-in-out infinite;
  }

  :global(.rock) .obj-svg {
    animation: rock 5.5s ease-in-out infinite;
  }

  :global(.floaty) .obj-svg {
    animation: floaty 13s ease-in-out infinite;
  }

  :global(.bobbing) .obj-svg {
    animation: bob 7s ease-in-out infinite;
  }
</style>
