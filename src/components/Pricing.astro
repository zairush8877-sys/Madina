---
import LuxObject from './LuxObject.astro';
import { site } from '../content/site';
---

<section class="section pricing-section" id="pricing">
  <div class="decor" aria-hidden="true">
    <LuxObject name="vase" class="pr-obj pr-obj--vase floaty" depth={0.35} />
    <LuxObject name="pendant" class="pr-obj pr-obj--pendant sway" depth={0.2} />
  </div>

  <div class="wrap">
    <header class="pricing__head">
      <p class="eyebrow reveal">{site.pricing.eyebrow}</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">{site.pricing.title}</h2>
    </header>

    <div class="pricing__grid">
      {
        site.pricing.items.map((item, i) => (
          <article
            class="price reveal"
            data-tilt
            style={`--reveal-delay: ${(i * 0.08).toFixed(2)}s`}
          >
            <h3 class="price__title">{item.title}</h3>
            <p class="price__amount">
              <span class="price__value">{item.price}</span>
              {item.unit && <span class="price__unit">{item.unit}</span>}
            </p>
            <p class="price__note">{item.note}</p>
          </article>
        ))
      }
    </div>

    <p class="pricing__footnote reveal">{site.pricing.footnote}</p>

    <div class="pricing__cta-row reveal">
      <a
        class="btn"
        href={site.contacts.whatsappHref}
        target="_blank"
        rel="noopener"
      >
        Рассчитать мой проект
      </a>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background: var(--paper-2);
    border-block: 1px solid var(--hairline);
    overflow: hidden;
  }

  :global(.pr-obj--vase) {
    width: 50px;
    top: 10%;
    right: 5%;
  }

  :global(.pr-obj--pendant) {
    width: 54px;
    top: -4px;
    left: 6%;
    color: var(--ink-3);
  }

  .pricing__head {
    max-width: 54rem;
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  .pricing__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.4rem;
  }

  .price {
    position: relative;
    padding: 2.2rem 2rem;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--hairline);
    /* Shorthand перекрывает transition из .js .reveal (идёт позже
       в собранном CSS), поэтому переходы появления — opacity и translate
       с задержкой каскада — обязаны повторяться здесь. transform остаётся
       быстрым: его пишет tilt-эффект из motion.ts. */
    transition: transform 0.2s ease, box-shadow 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out),
      opacity 0.85s var(--ease-out) var(--reveal-delay, 0s),
      translate 0.85s var(--ease-out) var(--reveal-delay, 0s);
    will-change: transform;
  }

  .price::before {
    content: '';
    position: absolute;
    top: 0;
    left: 2rem;
    right: 2rem;
    height: 1px;
    background: linear-gradient(90deg, var(--brass), transparent);
  }

  .price:hover {
    border-color: var(--brass);
    box-shadow: var(--shadow-soft);
  }

  .price__title {
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bronze);
    font-weight: 700;
    margin-bottom: 1.4rem;
  }

  .price__amount {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .price__value {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
    line-height: 1;
  }

  .price__unit {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink-3);
  }

  .price__note {
    font-size: 0.92rem;
    color: var(--ink-2);
    margin: 0;
  }

  .pricing__footnote {
    margin-top: 2rem;
    font-size: 0.92rem;
    color: var(--ink-3);
    max-width: 48rem;
  }

  .pricing__cta-row {
    margin-top: 2.25rem;
  }
</style>
