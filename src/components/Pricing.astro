---
import { site } from '../content/site';
---

<section class="section" id="pricing">
  <div class="wrap">
    <header class="pricing__head">
      <p class="eyebrow reveal">{site.pricing.eyebrow}</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">{site.pricing.title}</h2>
    </header>

    <div class="pricing__grid">
      {
        site.pricing.items.map((item, i) => (
          <article
            class="price panel reveal"
            data-tilt
            style={`--reveal-delay: ${i * 0.08}s`}
          >
            <h3 class="price__title">{item.title}</h3>
            <p class="price__amount">
              <span class="price__value">{item.price}</span>
              {item.unit && <span class="price__unit">{item.unit}</span>}
            </p>
            <p class="price__note">{item.note}</p>
            <span class="price__rule" aria-hidden="true" />
          </article>
        ))
      }
    </div>

    <p class="pricing__footnote reveal">{site.pricing.footnote}</p>

    <div class="pricing__cta-row reveal">
      <a
        class="btn btn--solid"
        href={site.contacts.whatsappHref}
        target="_blank"
        rel="noopener"
      >
        Рассчитать мой проект
      </a>
    </div>
  </div>
</section>

<style>
  .pricing__head {
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  .pricing__head .eyebrow {
    justify-content: center;
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.4rem;
  }

  .price {
    position: relative;
    padding: clamp(2rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    will-change: transform;
  }

  .price::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      240px circle at var(--px, 50%) var(--py, 50%),
      rgba(201, 168, 106, 0.13),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .price:hover {
    border-color: var(--gold);
    box-shadow: 0 0 30px rgba(201, 168, 106, 0.12);
  }

  .price:hover::before {
    opacity: 1;
  }

  .price__title {
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: 600;
    margin-bottom: 1.4rem;
  }

  .price__amount {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .price__value {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
    line-height: 1;
    color: var(--gold);
  }

  .price__unit {
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .price__note {
    font-size: 0.92rem;
    color: var(--ink-2);
    margin: 0 0 1.25rem;
  }

  .price__rule {
    width: 3rem;
    height: 1px;
    background: var(--gold);
    margin-top: auto;
  }

  .pricing__footnote {
    margin-top: 2rem;
    font-size: 0.92rem;
    color: var(--ink-3);
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }

  .pricing__cta-row {
    margin-top: 2.25rem;
    text-align: center;
  }
</style>
