---
import { site } from '../content/site';

const accents = ['var(--red)', 'var(--yellow)', 'var(--blue)'];
---

<section class="section pricing-section" id="pricing">
  <div class="shapes" aria-hidden="true">
    <span class="shape pr-sh1" data-depth="0.4"></span>
    <span class="shape shape--ring pr-sh2" data-depth="0.2"></span>
  </div>

  <div class="wrap">
    <header class="pricing__head">
      <p class="eyebrow reveal">{site.pricing.eyebrow}</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">{site.pricing.title}</h2>
    </header>

    <div class="pricing__grid">
      {
        site.pricing.items.map((item, i) => (
          <article
            class="price reveal"
            data-tilt
            style={`--reveal-delay: ${i * 0.08}s; --price-accent: ${accents[i % 3]}`}
          >
            <h3 class="price__title">{item.title}</h3>
            <p class="price__amount">
              <span class="price__value">{item.price}</span>
              {item.unit && <span class="price__unit">{item.unit}</span>}
            </p>
            <p class="price__note">{item.note}</p>
          </article>
        ))
      }
    </div>

    <p class="pricing__footnote reveal">{site.pricing.footnote}</p>

    <div class="pricing__cta-row reveal">
      <a
        class="btn"
        href={site.contacts.whatsappHref}
        target="_blank"
        rel="noopener"
      >
        Рассчитать мой проект
      </a>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    overflow: hidden;
  }

  .pr-sh1 {
    width: 0;
    height: 0;
    border-left: 70px solid transparent;
    border-right: 70px solid transparent;
    border-bottom: 120px solid var(--yellow);
    top: 8%;
    right: -30px;
    animation: drift 18s ease-in-out infinite;
  }

  .pr-sh2 {
    width: 260px;
    height: 260px;
    border: 2px dashed var(--blue);
    bottom: -90px;
    left: -70px;
    animation: spin-back 40s linear infinite;
  }

  .pricing__head {
    max-width: 54rem;
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  .pricing__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.4rem;
  }

  .price {
    position: relative;
    padding: 2rem 1.8rem;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 3px solid var(--ink);
    box-shadow: 8px 8px 0 0 var(--price-accent);
    transition: transform 0.2s ease, box-shadow 0.25s var(--ease-out);
    will-change: transform;
  }

  .price:hover {
    box-shadow: 12px 12px 0 0 var(--price-accent);
  }

  .price__title {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: 700;
    margin-bottom: 1.3rem;
  }

  .price__amount {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .price__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.8rem);
    line-height: 1;
  }

  .price__unit {
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .price__note {
    font-size: 0.92rem;
    color: var(--ink-2);
    margin: 0;
  }

  .pricing__footnote {
    margin-top: 2rem;
    font-size: 0.92rem;
    color: var(--ink-3);
    max-width: 48rem;
  }

  .pricing__cta-row {
    margin-top: 2.25rem;
  }
</style>
