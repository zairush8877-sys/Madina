---
import { site } from '../content/site';
import { withBase } from '../lib/url';

// Video lives in `public/` (not `src/assets/`) so the section can stay in the
// codebase while the file itself is still missing — no build-time import to fail.
const videoSrc = withBase(site.video.src);
const posterSrc = site.video.poster ? withBase(site.video.poster) : undefined;
---

<section class="section video-section" id="video">
  <div class="wrap video__inner">
    <div class="video__text">
      <p class="eyebrow reveal">{site.video.eyebrow}</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">{site.video.title}</h2>
      {
        site.video.caption && (
          <p class="video__caption reveal" style="--reveal-delay: 0.12s">
            {site.video.caption}
          </p>
        )
      }
    </div>

    <!-- Ролик снят вертикально (9:16) — плеер узкий, как экран телефона. -->
    <div class="video__frame reveal" style="--reveal-delay: 0.1s">
      <video
        class="video__player"
        src={videoSrc}
        poster={posterSrc}
        controls
        playsinline
        preload="none"
      >
        Ваш браузер не поддерживает воспроизведение видео.
      </video>
    </div>
  </div>
</section>

<style>
  .video-section {
    overflow: hidden;
  }

  .video__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .video__caption {
    margin-top: 1.5rem;
    color: var(--ink-2);
    max-width: 46ch;
  }

  .video__frame {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 19rem;
  }

  /* Паспарту: белое поле вокруг вертикального плеера. */
  .video__player {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    background: var(--paper);
    border: 1px solid var(--hairline);
    padding: 0.5rem;
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 860px) {
    .video__inner {
      grid-template-columns: 1fr;
    }
    .video__frame {
      max-width: 16rem;
      margin-inline: auto;
      margin-top: 3.5rem;
    }
  }
</style>
