---
import { site } from '../content/site';
import { withBase } from '../lib/url';

// Video lives in `public/` (not `src/assets/`) so the section can stay in the
// codebase while the file itself is still missing — no build-time import to fail.
const videoSrc = withBase(site.video.src);
const posterSrc = site.video.poster ? withBase(site.video.poster) : undefined;
---

<section class="section video-section" id="video">
  <div class="shapes" aria-hidden="true">
    <span
      class="shape shape--circle vid-sh1"
      data-depth="0.35"
      style="background: var(--red)"></span>
    <span class="shape vid-sh2" data-depth="0.2"></span>
  </div>

  <div class="wrap video__inner">
    <div class="video__text">
      <p class="eyebrow reveal">{site.video.eyebrow}</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">{site.video.title}</h2>
      {
        site.video.caption && (
          <p class="video__caption reveal" style="--reveal-delay: 0.12s">
            {site.video.caption}
          </p>
        )
      }
    </div>

    <!-- Ролик снят вертикально (9:16) — плеер узкий, как экран телефона. -->
    <div class="video__frame reveal" style="--reveal-delay: 0.1s">
      <span class="video__orbit" aria-hidden="true">
        <span class="video__satellite"></span>
      </span>
      <video
        class="video__player"
        src={videoSrc}
        poster={posterSrc}
        controls
        playsinline
        preload="none"
      >
        Ваш браузер не поддерживает воспроизведение видео.
      </video>
    </div>
  </div>
</section>

<style>
  .video-section {
    background: var(--paper-2);
    border-block: 2px solid var(--ink);
    overflow: hidden;
  }

  .vid-sh1 {
    width: 44px;
    height: 44px;
    top: 16%;
    left: 4%;
    animation: bob 6.5s ease-in-out infinite;
  }

  .vid-sh2 {
    width: 110px;
    height: 22px;
    background: var(--blue);
    bottom: 12%;
    left: 10%;
    animation: drift 15s ease-in-out infinite;
  }

  .video__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .video__caption {
    margin-top: 1.5rem;
    color: var(--ink-2);
    max-width: 46ch;
  }

  .video__frame {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 19rem;
  }

  .video__player {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    background: #000;
    border: 4px solid var(--ink);
    box-shadow: 10px 10px 0 0 var(--red);
  }

  /* Жёлтый «спутник» облетает плеер по пунктирной орбите. */
  .video__orbit {
    position: absolute;
    inset: -40px;
    border: 2px dashed rgba(23, 21, 15, 0.35);
    border-radius: 50%;
    animation: spin-back 24s linear infinite;
    pointer-events: none;
  }

  .video__satellite {
    position: absolute;
    top: -12px;
    left: calc(50% - 12px);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--yellow);
    border: 3px solid var(--paper-2);
  }

  @media (max-width: 860px) {
    .video__inner {
      grid-template-columns: 1fr;
    }
    .video__frame {
      max-width: 16rem;
      margin-inline: auto;
    }
  }
</style>
