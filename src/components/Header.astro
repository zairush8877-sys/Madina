---
import { site } from '../content/site';
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="#top">
      <span class="brand__gem" aria-hidden="true"></span>
      <span class="brand__name">{site.person.fullName}</span>
    </a>

    <nav class="site-nav" aria-label="Основная навигация">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="site-header__phone" href={`tel:${site.contacts.phoneHref}`}>
      {site.contacts.phoneLabel}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--hairline);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 2.5rem);
    min-height: 4.2rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    margin-right: auto;
  }

  /* Латунный ромб медленно вращается — единственное движение шапки. */
  .brand__gem {
    width: 11px;
    height: 11px;
    background: linear-gradient(135deg, var(--brass-2), var(--brass));
    rotate: 45deg;
    animation: gem-turn 9s ease-in-out infinite;
  }

  @keyframes gem-turn {
    0%,
    100% {
      rotate: 45deg;
    }
    50% {
      rotate: 225deg;
    }
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: 0.015em;
  }

  .site-nav {
    display: flex;
    gap: clamp(0.9rem, 2.2vw, 1.8rem);
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .site-nav a {
    position: relative;
    text-decoration: none;
    color: var(--ink-2);
    padding-block: 0.4rem;
    transition: color 0.25s ease;
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--brass);
    transition: right 0.35s var(--ease-out);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--ink);
  }

  .site-nav a:hover::after,
  .site-nav a:focus-visible::after {
    right: 0;
  }

  .site-header__phone {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink);
    transition: color 0.25s ease;
  }

  .site-header__phone:hover,
  .site-header__phone:focus-visible {
    color: var(--bronze);
  }

  @media (max-width: 900px) {
    .site-header__inner {
      padding-block: 0.65rem;
      row-gap: 0.3rem;
    }
    .site-nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.3rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .site-nav::-webkit-scrollbar {
      display: none;
    }
    .site-nav a {
      white-space: nowrap;
    }
  }
</style>
