---
import { site } from '../content/site';
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="#top">
      <span class="brand__diamond" aria-hidden="true">◆</span>
      <span class="brand__name">{site.person.fullName}</span>
    </a>

    <nav class="site-nav" aria-label="Основная навигация">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="site-header__phone" href={`tel:${site.contacts.phoneHref}`}>
      {site.contacts.phoneLabel}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(18, 16, 13, 0.82);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 2.5rem);
    min-height: 4.4rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
    margin-right: auto;
  }

  .brand__diamond {
    color: var(--gold);
    font-size: 0.7rem;
    animation: glint 4s ease-in-out infinite;
  }

  @keyframes glint {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
      text-shadow: 0 0 10px rgba(201, 168, 106, 0.8);
    }
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.06em;
  }

  .site-nav {
    display: flex;
    gap: clamp(0.9rem, 2.2vw, 1.8rem);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .site-nav a {
    position: relative;
    text-decoration: none;
    color: var(--ink-2);
    padding-block: 0.4rem;
    transition: color 0.25s ease;
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--gold);
    transition: right 0.35s var(--ease-out);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--gold);
  }

  .site-nav a:hover::after,
  .site-nav a:focus-visible::after {
    right: 0;
  }

  .site-header__phone {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--gold);
    transition: text-shadow 0.25s ease;
  }

  .site-header__phone:hover,
  .site-header__phone:focus-visible {
    text-shadow: 0 0 14px rgba(201, 168, 106, 0.7);
  }

  @media (max-width: 900px) {
    .site-header__inner {
      padding-block: 0.7rem;
      row-gap: 0.35rem;
    }
    .site-nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.3rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .site-nav::-webkit-scrollbar {
      display: none;
    }
    .site-nav a {
      white-space: nowrap;
    }
  }
</style>
