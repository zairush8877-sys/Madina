---
import { site } from '../content/site';
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="#top">
      <span class="brand__dot" aria-hidden="true"></span>
      <span class="brand__name">{site.person.fullName}</span>
    </a>

    <nav class="site-nav" aria-label="Основная навигация">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="site-header__phone" href={`tel:${site.contacts.phoneHref}`}>
      {site.contacts.phoneLabel}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 2.5rem);
    min-height: 4.2rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    margin-right: auto;
  }

  /* Красный круг медленно «дышит» — единственный движущийся элемент шапки. */
  .brand__dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--red);
    animation: breathe 3.6s ease-in-out infinite;
  }

  @keyframes breathe {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 1.35;
    }
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .site-nav {
    display: flex;
    gap: clamp(0.9rem, 2.2vw, 1.7rem);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .site-nav a {
    position: relative;
    text-decoration: none;
    color: var(--ink-2);
    padding-block: 0.4rem;
    transition: color 0.2s ease;
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 3px;
    background: var(--red);
    transition: right 0.3s var(--ease-out);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--ink);
  }

  .site-nav a:hover::after,
  .site-nav a:focus-visible::after {
    right: 0;
  }

  .site-header__phone {
    font-family: var(--font-display);
    font-size: 0.72rem;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .site-header__inner {
      padding-block: 0.65rem;
      row-gap: 0.3rem;
    }
    .site-nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.3rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .site-nav::-webkit-scrollbar {
      display: none;
    }
    .site-nav a {
      white-space: nowrap;
    }
  }
</style>
