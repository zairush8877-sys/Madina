---
import { Picture } from 'astro:assets';
import { site } from '../content/site';
import interiorA from '../assets/photos/lux-dark-cabinet.jpg';
import interiorB from '../assets/photos/lux-cane-stool.jpg';
---

<section class="section about-section" id="about">
  <div class="wrap about">
    <div class="about__media reveal">
      <!-- Классы — на div-обёртках: у <Picture /> класс уходит на сам
           <img> без scoped-атрибута, и стили компонента до него
           не дотягиваются. -->
      <div class="about__img about__img--a">
        <Picture
          src={interiorA}
          alt="Кабинет с тёмными ботаническими обоями и деревянным столом"
          widths={[360, 620]}
          sizes="(max-width: 900px) 45vw, 24vw"
          formats={['avif', 'webp']}
          loading="lazy"
        />
      </div>
      <div class="about__img about__img--b">
        <Picture
          src={interiorB}
          alt="Ротанговый стул ручной работы с латунным кувшином"
          widths={[300, 520]}
          sizes="(max-width: 900px) 38vw, 19vw"
          formats={['avif', 'webp']}
          loading="lazy"
        />
      </div>
    </div>

    <div class="about__text">
      <p class="eyebrow reveal">{site.about.eyebrow}</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">{site.about.title}</h2>
      <div class="about__body">
        {
          site.about.paragraphs.map((p, i) => (
            <p class="reveal" style={`--reveal-delay: ${(0.1 + i * 0.06).toFixed(2)}s`}>
              {p}
            </p>
          ))
        }
      </div>
      <blockquote class="about__quote reveal" style="--reveal-delay: 0.2s">
        {site.about.quote}
      </blockquote>
    </div>
  </div>
</section>

<style>
  .about-section {
    background: var(--paper-2);
    border-block: 1px solid var(--hairline);
    overflow: hidden;
  }

  .about {
    position: relative;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .about__media {
    position: relative;
    padding-bottom: 4.5rem;
  }

  .about__img :global(img),
  .about__img {
    width: 100%;
  }

  /* Большое фото — в арочной раме, как в референсах. */
  .about__img--a :global(img) {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 999px 999px 0 0;
    box-shadow: var(--shadow-soft);
  }

  .about__img--b {
    position: absolute;
    right: -1rem;
    bottom: 0;
    width: 54%;
    /* Паспарту: белое поле и тонкая рама, как у гравюры. */
    background: var(--paper);
    padding: 0.55rem;
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-soft);
  }

  .about__img--b :global(img) {
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .about__body {
    margin-top: 1.75rem;
    color: var(--ink-2);
  }

  .about__quote {
    margin: 2.5rem 0 0;
    padding: 0 0 0 1.6rem;
    border-left: 1px solid var(--brass);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
    line-height: 1.45;
    font-weight: 500;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__media {
      max-width: 23rem;
      padding-bottom: 3.5rem;
    }
  }
</style>
