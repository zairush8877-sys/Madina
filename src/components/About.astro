---
import { Picture } from 'astro:assets';
import { site } from '../content/site';
import portraitA from '../assets/photos/portrait-evening-01.jpg';
import portraitB from '../assets/photos/portrait-flowers-01.jpg';
---

<section class="section about-section" id="about">
  <div class="wrap about">
    <div class="about__media reveal">
      <Picture
        class="about__img about__img--a"
        src={portraitA}
        alt={`${site.person.fullName}`}
        widths={[360, 620]}
        sizes="(max-width: 900px) 45vw, 24vw"
        formats={['avif', 'webp']}
        loading="lazy"
      />
      <Picture
        class="about__img about__img--b"
        src={portraitB}
        alt={`${site.person.fullName} — портрет`}
        widths={[300, 520]}
        sizes="(max-width: 900px) 38vw, 19vw"
        formats={['avif', 'webp']}
        loading="lazy"
      />
    </div>

    <div class="about__text">
      <p class="eyebrow eyebrow--start reveal">{site.about.eyebrow}</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">{site.about.title}</h2>
      <div class="about__body">
        {
          site.about.paragraphs.map((p, i) => (
            <p class="reveal" style={`--reveal-delay: ${0.1 + i * 0.06}s`}>
              {p}
            </p>
          ))
        }
      </div>
      <blockquote class="about__quote reveal" style="--reveal-delay: 0.2s">
        {site.about.quote}
      </blockquote>
    </div>
  </div>
</section>

<style>
  .about-section {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }

  .about {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .about__media {
    position: relative;
    padding-bottom: 4.5rem;
  }

  .about__img :global(img),
  .about__img {
    width: 100%;
  }

  /* Большой портрет — в арке, малый — ромбом срезанные углы не нужны:
     просто строгая золотая рамка с отступом-паспарту. */
  .about__img--a :global(img) {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 50% 50% 0 0 / 30% 30% 0 0;
    border: 1px solid var(--gold-soft);
    padding: 10px;
    background: var(--bg-2);
  }

  .about__img--b {
    position: absolute;
    right: -1rem;
    bottom: 0;
    width: 52%;
  }

  .about__img--b :global(img) {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--gold);
    padding: 8px;
    background: var(--bg-2);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.55);
  }

  .about__body {
    margin-top: 1.75rem;
    color: var(--ink-2);
  }

  .about__quote {
    margin: 2.25rem 0 0;
    padding: 1.5rem 1.75rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.6rem);
    line-height: 1.45;
    color: var(--ink);
    border: 1px solid var(--line);
    background: linear-gradient(180deg, var(--gold-faint), transparent 50%);
    position: relative;
  }

  .about__quote::before {
    content: '◆';
    position: absolute;
    top: -0.55rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--gold);
    font-size: 0.7rem;
    background: var(--bg-2);
    padding-inline: 0.5rem;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__media {
      max-width: 23rem;
      padding-bottom: 3.5rem;
    }
  }
</style>
