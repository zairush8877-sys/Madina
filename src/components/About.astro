---
import { Picture } from 'astro:assets';
import { site } from '../content/site';
import portraitA from '../assets/photos/portrait-evening-01.jpg';
import portraitB from '../assets/photos/portrait-flowers-01.jpg';
---

<section class="section about-section" id="about">
  <div class="shapes" aria-hidden="true">
    <span class="shape shape--ring about-sh1" data-depth="0.25"></span>
    <span
      class="shape shape--circle about-sh2"
      data-depth="0.5"
      style="background: var(--yellow)"></span>
  </div>

  <div class="wrap about">
    <div class="about__media reveal">
      <span class="about__spinner" aria-hidden="true"></span>
      <Picture
        class="about__img about__img--a"
        src={portraitA}
        alt={`${site.person.fullName}`}
        widths={[360, 620]}
        sizes="(max-width: 900px) 45vw, 24vw"
        formats={['avif', 'webp']}
        loading="lazy"
      />
      <Picture
        class="about__img about__img--b"
        src={portraitB}
        alt={`${site.person.fullName} — портрет`}
        widths={[300, 520]}
        sizes="(max-width: 900px) 38vw, 19vw"
        formats={['avif', 'webp']}
        loading="lazy"
      />
    </div>

    <div class="about__text">
      <p class="eyebrow reveal">{site.about.eyebrow}</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">{site.about.title}</h2>
      <div class="about__body">
        {
          site.about.paragraphs.map((p, i) => (
            <p class="reveal" style={`--reveal-delay: ${0.1 + i * 0.06}s`}>
              {p}
            </p>
          ))
        }
      </div>
      <blockquote class="about__quote reveal" style="--reveal-delay: 0.2s">
        {site.about.quote}
      </blockquote>
    </div>
  </div>
</section>

<style>
  .about-section {
    background: var(--paper-2);
    border-block: 2px solid var(--ink);
    overflow: hidden;
  }

  .about-sh1 {
    width: 300px;
    height: 300px;
    border: 2px dashed var(--red);
    top: -110px;
    right: -80px;
    animation: spin-back 44s linear infinite;
  }

  .about-sh2 {
    width: 46px;
    height: 46px;
    bottom: 14%;
    right: 8%;
    animation: bob 5.5s ease-in-out infinite;
  }

  .about {
    position: relative;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .about__media {
    position: relative;
    padding-bottom: 4.5rem;
  }

  /* Вращающийся квадрат за фотографиями. */
  .about__spinner {
    position: absolute;
    top: -34px;
    left: -34px;
    width: 130px;
    height: 130px;
    border: 3px solid var(--blue);
    animation: spin 22s linear infinite;
  }

  .about__img :global(img),
  .about__img {
    width: 100%;
  }

  .about__img--a :global(img) {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 4px solid var(--ink);
  }

  .about__img--b {
    position: absolute;
    right: -1rem;
    bottom: 0;
    width: 52%;
  }

  .about__img--b :global(img) {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0 0 var(--red);
  }

  .about__body {
    margin-top: 1.75rem;
    color: var(--ink-2);
  }

  .about__quote {
    margin: 2.25rem 0 0;
    padding: 1.4rem 1.6rem;
    border: 3px solid var(--ink);
    background: var(--paper);
    box-shadow: 8px 8px 0 0 var(--yellow);
    font-size: 1.02rem;
    line-height: 1.65;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__media {
      max-width: 23rem;
      padding-bottom: 3.5rem;
    }
  }
</style>
