---
import { site } from '../content/site';
---

<section class="section approach-section" id="approach">
  <div class="wrap">
    <header class="approach__head">
      <p class="eyebrow reveal">{site.approach.eyebrow}</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">{site.approach.title}</h2>
      <p class="lede reveal" style="--reveal-delay: 0.12s">{site.approach.lede}</p>
    </header>

    <div class="approach__grid">
      {
        site.approach.items.map((item, i) => (
          <article
            class="approach__item reveal"
            style={`--reveal-delay: ${((i % 2) * 0.08).toFixed(2)}s`}
          >
            <span class="approach__beam draw-line" aria-hidden="true" />
            <span class="approach__index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .approach-section {
    background: var(--paper-2);
    border-block: 1px solid var(--hairline);
    overflow: hidden;
  }

  .approach__head {
    max-width: 54rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .approach__head h2 {
    margin-bottom: 1.25rem;
  }

  .approach__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .approach__item {
    position: relative;
    padding-top: 1.6rem;
  }

  /* Латунная линия, прорисовывающаяся при появлении блока
     (механика .draw-line из global.css; без JS видна сразу). */
  .approach__beam {
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, var(--brass), var(--brass-2) 60%, transparent);
  }

  .approach__index {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 2.4rem;
    color: var(--brass);
    line-height: 1;
    display: block;
    margin-bottom: 0.9rem;
  }

  .approach__item h3 {
    margin-bottom: 0.75rem;
  }

  .approach__item p {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
</style>
