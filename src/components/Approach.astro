---
import { site } from '../content/site';
---

<section class="section approach-section" id="approach">
  <div class="wrap">
    <header class="approach__head">
      <p class="eyebrow eyebrow--start reveal">{site.approach.eyebrow}</p>
      <h2 class="reveal" style="--reveal-delay: 0.06s">{site.approach.title}</h2>
      <p class="lede reveal" style="--reveal-delay: 0.12s">{site.approach.lede}</p>
    </header>

    <div class="approach__grid">
      {
        site.approach.items.map((item, i) => (
          <article
            class="approach__item reveal"
            style={`--reveal-delay: ${(i % 2) * 0.08}s`}
          >
            <span class="approach__beam" aria-hidden="true" />
            <span class="approach__index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .approach-section {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }

  .approach__head {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .approach__head h2 {
    margin-bottom: 1.25rem;
  }

  .approach__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .approach__item {
    position: relative;
    padding-top: 1.6rem;
  }

  /* Золотая линия, «зажигающаяся» при появлении блока.
     Свёрнута только при работающем JS — без него видна сразу. */
  .approach__beam {
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, var(--gold), var(--gold-faint));
    transform-origin: left;
    transition: transform 1.2s var(--ease-out) 0.25s;
  }

  :global(.js) .approach__item:not(.is-visible) .approach__beam {
    transform: scaleX(0);
  }

  .approach__index {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: transparent;
    -webkit-text-stroke: 1px var(--gold-soft);
    line-height: 1;
    display: block;
    margin-bottom: 0.9rem;
  }

  .approach__item h3 {
    margin-bottom: 0.75rem;
  }

  .approach__item p {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
</style>
