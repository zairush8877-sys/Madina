---
import { site } from '../content/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="site-footer__brand">
      <span class="site-footer__gem" aria-hidden="true"></span>
      {site.person.fullName} — {site.person.role.toLowerCase()}, {site.person.city}
    </p>
    <p class="site-footer__legal">© {year}. Все права защищены.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #8f8778;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: 1.75rem;
    font-size: 0.83rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    justify-content: space-between;
    align-items: center;
  }

  .site-footer p {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .site-footer__gem {
    width: 8px;
    height: 8px;
    background: linear-gradient(135deg, var(--brass-2), var(--brass));
    rotate: 45deg;
  }
</style>
