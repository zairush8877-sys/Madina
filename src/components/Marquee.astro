---
import { site } from '../content/site';

// Бегущая строка из названий услуг — дублируем список дважды,
// чтобы бесшовно зациклить прокрутку.
const items = site.services.map((s) => s.title);
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {
      [0, 1].map(() => (
        <span class="marquee__seq">
          {items.map((t) => (
            <span class="marquee__item">
              {t}
              <span class="marquee__dot" />
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--hairline);
    background: var(--paper);
    padding-block: 1.05rem;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    /* marquee-half — общий keyframe из global.css. */
    animation: marquee-half 30s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__seq {
    display: flex;
    flex: none;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 1.6rem;
    padding-inline: 0.8rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.18rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--ink-2);
  }

  .marquee__dot {
    width: 7px;
    height: 7px;
    background: var(--brass);
    rotate: 45deg;
  }
</style>
