---
import { Picture } from 'astro:assets';
import { site } from '../content/site';
import heroPortrait from '../assets/photos/portrait-evening-02.jpg';

const titleLines = site.hero.title.split('\n');
---

<section class="hero" id="top">
  <!-- Живые фигуры: дрейфуют сами по себе и плывут за курсором. -->
  <div class="shapes" aria-hidden="true">
    <span
      class="shape shape--circle hero-sh1"
      data-depth="0.35"
      style="background: var(--yellow)"></span>
    <span class="shape shape--ring hero-sh2" data-depth="0.2"></span>
    <span class="shape hero-sh3" data-depth="0.5"></span>
    <span
      class="shape shape--circle hero-sh4"
      data-depth="0.7"
      style="background: var(--red)"></span>
    <span class="shape hero-sh5" data-depth="0.28"></span>
  </div>

  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="eyebrow reveal">{site.hero.kicker}</p>
      <h1 class="reveal" style="--reveal-delay: 0.08s">
        {
          titleLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {i === titleLines.length - 1 ? (
                <span class="accent-red">{line}</span>
              ) : (
                line
              )}
            </>
          ))
        }
      </h1>
      <p class="lede hero__lede reveal" style="--reveal-delay: 0.16s">
        {site.hero.lede}
      </p>
      <div class="hero__actions reveal" style="--reveal-delay: 0.24s">
        <a
          class="btn"
          href={site.contacts.whatsappHref}
          target="_blank"
          rel="noopener"
        >
          {site.hero.primaryCta}
        </a>
        <a class="btn btn--ghost" href="#services">{site.hero.secondaryCta}</a>
      </div>
    </div>

    <div class="hero__figure reveal" style="--reveal-delay: 0.18s">
      <span class="hero__orbit" aria-hidden="true">
        <span class="hero__satellite"></span>
      </span>
      <Picture
        src={heroPortrait}
        alt={`${site.person.fullName} — ${site.person.role.toLowerCase()}`}
        widths={[420, 700, 900]}
        sizes="(max-width: 900px) 76vw, 34vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    overflow: hidden;
  }

  /* --- фигуры --- */
  .hero-sh1 {
    width: 340px;
    height: 340px;
    top: -90px;
    right: 6%;
    animation: drift 17s ease-in-out infinite;
  }

  .hero-sh2 {
    width: 480px;
    height: 480px;
    border: 2px dashed var(--blue);
    bottom: -190px;
    left: -140px;
    animation: spin 50s linear infinite;
  }

  .hero-sh3 {
    width: 0;
    height: 0;
    border-left: 95px solid transparent;
    border-right: 95px solid transparent;
    border-bottom: 160px solid var(--blue);
    bottom: 6%;
    right: -40px;
    animation: drift 21s ease-in-out infinite reverse;
  }

  .hero-sh4 {
    width: 60px;
    height: 60px;
    top: 22%;
    left: 42%;
    animation: bob 6s ease-in-out infinite;
  }

  .hero-sh5 {
    width: 120px;
    height: 26px;
    background: var(--red);
    top: 62%;
    left: -30px;
    animation: drift 14s ease-in-out infinite;
  }

  /* --- сетка героя --- */
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(2.5rem, 7vw, 5.5rem);
    align-items: center;
  }

  .hero__lede {
    margin-top: 1.6rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 2.4rem;
  }

  .hero__figure {
    position: relative;
    justify-self: center;
    width: min(20.5rem, 100%);
  }

  .hero__figure :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 20%;
    border: 4px solid var(--ink);
    box-shadow: 10px 10px 0 0 var(--yellow);
  }

  /* Орбита со «спутником»: пунктирное кольцо и синий кружок,
     непрерывно облетающий портрет. */
  .hero__orbit {
    position: absolute;
    inset: -46px;
    border: 2px dashed rgba(23, 21, 15, 0.35);
    border-radius: 50%;
    animation: spin 28s linear infinite;
    pointer-events: none;
  }

  .hero__satellite {
    position: absolute;
    top: -13px;
    left: calc(50% - 13px);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--blue);
    border: 3px solid var(--paper);
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__figure {
      order: -1;
      width: min(16rem, 82%);
      margin-inline: auto;
      margin-top: 1.5rem;
    }
    .hero-sh2 {
      display: none;
    }
  }
</style>
