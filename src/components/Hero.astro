---
import { Picture } from 'astro:assets';
import LuxObject from './LuxObject.astro';
import { site } from '../content/site';
import heroInterior from '../assets/photos/lux-arch-hall.jpg';

const titleLines = site.hero.title.split('\n');
---

<section class="hero" id="top">
  <!-- Живые предметы: светильник качается, стул покачивается,
       дверная ручка время от времени нажимается. Все плывут за курсором. -->
  <div class="decor" aria-hidden="true">
    <LuxObject name="pendant" class="hero-obj hero-obj--pendant sway" depth={0.22} />
    <LuxObject name="chair" class="hero-obj hero-obj--chair rock" depth={0.4} />
    <LuxObject name="lever" class="hero-obj hero-obj--lever floaty" depth={0.55} />
    <LuxObject name="vase" class="hero-obj hero-obj--vase floaty" depth={0.18} />
    <LuxObject name="key" class="hero-obj hero-obj--key sway-slow" depth={0.32} />
  </div>

  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="eyebrow reveal">{site.hero.kicker}</p>
      <h1 class="reveal" style="--reveal-delay: 0.08s">
        {
          titleLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {i === titleLines.length - 1 ? (
                <em class="accent shimmer">{line}</em>
              ) : (
                line
              )}
            </>
          ))
        }
      </h1>
      <p class="lede hero__lede reveal" style="--reveal-delay: 0.16s">
        {site.hero.lede}
      </p>
      <div class="hero__actions reveal" style="--reveal-delay: 0.24s">
        <a
          class="btn"
          href={site.contacts.whatsappHref}
          target="_blank"
          rel="noopener"
        >
          {site.hero.primaryCta}
        </a>
        <a class="btn btn--ghost" href="#services">{site.hero.secondaryCta}</a>
      </div>
    </div>

    <div class="hero__figure reveal" style="--reveal-delay: 0.18s">
      <Picture
        src={heroInterior}
        alt="Кремовый холл с арочной нишей, латунной консолью и подвесным светильником"
        widths={[420, 700, 1000]}
        sizes="(max-width: 900px) 76vw, 36vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(4rem, 9vw, 7rem);
    overflow: hidden;
  }

  /* --- предметы --- */
  :global(.hero-obj--pendant) {
    width: 64px;
    top: -6px;
    left: 4%;
  }

  :global(.hero-obj--chair) {
    width: 72px;
    bottom: 7%;
    right: 3%;
    color: var(--ink-3);
  }

  :global(.hero-obj--lever) {
    width: 96px;
    top: 56%;
    left: -14px;
    color: var(--brass);
  }

  :global(.hero-obj--vase) {
    width: 54px;
    top: 11%;
    right: 8.5%;
    color: var(--ink-3);
  }

  :global(.hero-obj--key) {
    width: 30px;
    top: 47%;
    left: 47.5%;
  }

  /* Серифный заголовок чуть компактнее общего h1, чтобы строка
     «Интерьеры, в которых» не ломалась посреди. */
  .hero__text h1 {
    font-size: clamp(2.2rem, 1.1rem + 2.9vw, 3.4rem);
  }

  /* --- сетка героя --- */
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(2.5rem, 7vw, 5.5rem);
    align-items: center;
  }

  .hero__lede {
    margin-top: 1.7rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 2.6rem;
  }

  /* Фото в арочной раме — мотив с референсов; за ним тонкий
     латунный контур-дубль, чуть смещённый. */
  .hero__figure {
    position: relative;
    justify-self: center;
    width: min(21.5rem, 100%);
  }

  .hero__figure::before {
    content: '';
    position: absolute;
    inset: 0;
    translate: 16px 16px;
    border: 1px solid var(--brass);
    border-radius: 999px 999px 0 0;
    pointer-events: none;
  }

  .hero__figure :global(img) {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4.1;
    object-fit: cover;
    border-radius: 999px 999px 0 0;
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__figure {
      order: -1;
      width: min(17rem, 84%);
      margin-inline: auto;
      margin-top: 1.25rem;
    }
    :global(.hero-obj--key),
    :global(.hero-obj--vase),
    :global(.hero-obj--lever) {
      display: none;
    }
    :global(.hero-obj--pendant) {
      left: 7%;
      top: 0;
      width: 48px;
    }
    :global(.hero-obj--chair) {
      bottom: auto;
      top: 4%;
      right: 3%;
      width: 48px;
    }
  }
</style>
