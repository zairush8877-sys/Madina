---
import { Picture } from 'astro:assets';
import { site } from '../content/site';
import heroPortrait from '../assets/photos/portrait-garden-01.jpg';

// «Интерьеры, в которых\nудобно жить» → последняя строка золотым курсивом.
const titleLines = site.hero.title.split('\n');
---

<section class="hero" id="top">
  <div class="hero__sun" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="eyebrow eyebrow--start reveal">{site.hero.kicker}</p>
      <h1 class="reveal" style="--reveal-delay: 0.08s">
        {
          titleLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {i === titleLines.length - 1 ? <em class="accent">{line}</em> : line}
            </>
          ))
        }
      </h1>
      <p class="lede hero__lede reveal" style="--reveal-delay: 0.16s">
        {site.hero.lede}
      </p>
      <div class="hero__actions reveal" style="--reveal-delay: 0.24s">
        <a
          class="btn"
          href={site.contacts.whatsappHref}
          target="_blank"
          rel="noopener"
        >
          {site.hero.primaryCta}
        </a>
        <a class="btn btn--muted" href="#services">{site.hero.secondaryCta}</a>
      </div>
    </div>

    <div class="hero__figure reveal" style="--reveal-delay: 0.18s">
      <span class="hero__finial" aria-hidden="true"></span>
      <Picture
        src={heroPortrait}
        alt={`${site.person.fullName} — ${site.person.role.toLowerCase()}`}
        widths={[420, 700, 900]}
        sizes="(max-width: 900px) 76vw, 34vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(4.5rem, 11vw, 9rem);
    overflow: hidden;
  }

  /* Солнечные лучи из нижнего центра — фирменный мотив ар-деко. */
  .hero__sun {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(760px, 90vw);
    height: 340px;
    border-radius: 380px 380px 0 0;
    background: conic-gradient(
      from 270deg at 50% 100%,
      transparent 0deg 6deg,
      var(--gold-faint) 6deg 7deg,
      transparent 7deg 16deg,
      var(--gold-faint) 16deg 17deg,
      transparent 17deg 26deg,
      var(--gold-faint) 26deg 27deg,
      transparent 27deg 36deg,
      var(--gold-faint) 36deg 37deg,
      transparent 37deg 46deg,
      var(--gold-faint) 46deg 47deg,
      transparent 47deg 56deg,
      var(--gold-faint) 56deg 57deg,
      transparent 57deg 66deg,
      var(--gold-faint) 66deg 67deg,
      transparent 67deg 76deg,
      var(--gold-faint) 76deg 77deg,
      transparent 77deg 86deg,
      var(--gold-faint) 86deg 87deg,
      transparent 87deg 90deg
    );
    opacity: 0;
    animation: sunrise 2.2s var(--ease-out) 0.4s forwards;
    pointer-events: none;
  }

  @keyframes sunrise {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 7vw, 5.5rem);
    align-items: center;
  }

  .hero__lede {
    margin-top: 1.6rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
  }

  /* Портрет в арке с двойной золотой рамкой и «шпилем». */
  .hero__figure {
    position: relative;
    justify-self: center;
    width: min(21rem, 100%);
  }

  .hero__figure :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4.2;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 50% 50% 0 0 / 38% 38% 0 0;
    border: 1px solid var(--gold);
    padding: 12px;
    background: var(--bg);
  }

  /* Внешняя арка. */
  .hero__figure::after {
    content: '';
    position: absolute;
    inset: -24px -24px 0;
    border: 1px solid var(--gold-soft);
    border-bottom: 0;
    border-radius: 50% 50% 0 0 / 36% 36% 0 0;
    pointer-events: none;
  }

  /* Вертикальный «шпиль» над аркой. */
  .hero__finial {
    position: absolute;
    left: 50%;
    top: -66px;
    width: 1px;
    height: 42px;
    background: var(--gold);
  }

  .hero__finial::after {
    content: '◆';
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--gold);
    font-size: 9px;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__figure {
      order: -1;
      width: min(17rem, 88%);
      margin-top: 3rem;
    }
  }
</style>
