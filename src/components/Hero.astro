---
import { Picture } from 'astro:assets';
import { site } from '../content/site';
import heroPortrait from '../assets/photos/portrait-garden-01.jpg';

const titleLines = site.hero.title.split('\n');
---

<section class="hero" id="top">
  <div class="hero__aurora" aria-hidden="true"></div>
  <div class="hero__grid" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="eyebrow reveal">{site.hero.kicker}</p>
      <h1 class="reveal" style="--reveal-delay: 0.08s">
        {
          titleLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {i === titleLines.length - 1 ? <span class="accent">{line}</span> : line}
            </>
          ))
        }
      </h1>
      <p class="lede hero__lede reveal" style="--reveal-delay: 0.16s">
        {site.hero.lede}
      </p>
      <div class="hero__actions reveal" style="--reveal-delay: 0.24s">
        <a
          class="btn"
          href={site.contacts.whatsappHref}
          target="_blank"
          rel="noopener"
        >
          {site.hero.primaryCta}
        </a>
        <a class="btn btn--ghost" href="#services">{site.hero.secondaryCta}</a>
      </div>
    </div>

    <div class="hero__figure reveal" style="--reveal-delay: 0.2s">
      <div class="hero__halo" aria-hidden="true"></div>
      <Picture
        src={heroPortrait}
        alt={`${site.person.fullName} — ${site.person.role.toLowerCase()}`}
        widths={[420, 700, 900]}
        sizes="(max-width: 900px) 78vw, 36vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 9vw, 7.5rem);
    overflow: hidden;
  }

  /* Живой аврора-фон: два размытых пятна медленно дрейфуют. */
  .hero__aurora {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(38% 42% at 22% 30%, rgba(127, 90, 240, 0.2), transparent 70%),
      radial-gradient(34% 38% at 78% 62%, rgba(226, 96, 123, 0.17), transparent 70%),
      radial-gradient(30% 34% at 55% 18%, rgba(245, 178, 99, 0.12), transparent 70%);
    animation: aurora 16s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes aurora {
    from {
      transform: translate3d(-2%, -1%, 0) scale(1);
    }
    to {
      transform: translate3d(2%, 2%, 0) scale(1.08);
    }
  }

  /* Тонкая перспективная сетка — намёк на чертёж. */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(75% 65% at 50% 40%, rgb(0 0 0 / 0.5), transparent);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero__lede {
    margin-top: 1.6rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.4rem;
  }

  .hero__figure {
    position: relative;
    animation: float 7s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -12px;
    }
  }

  /* Свечение позади портрета. */
  .hero__halo {
    position: absolute;
    inset: -12%;
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgba(226, 96, 123, 0.3),
      transparent 72%
    );
    filter: blur(30px);
    z-index: 0;
  }

  .hero__figure :global(img) {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 22%;
    border-radius: var(--radius);
    border: 1px solid rgba(244, 241, 236, 0.16);
  }

  /* Градиентный уголок-рамка. */
  .hero__figure::after {
    content: '';
    position: absolute;
    inset: -14px;
    border-radius: calc(var(--radius) + 12px);
    padding: 1px;
    background: var(--grad-accent);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.55;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__figure {
      order: -1;
      max-width: 21rem;
      margin-inline: auto;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__aurora,
    .hero__figure {
      animation: none;
    }
  }
</style>
